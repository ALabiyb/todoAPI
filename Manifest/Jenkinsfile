 * Determine if build type should be confirmed manually
 */
def shouldConfirmBuildType() {
	// Add logic to determine when manual confirmation is needed
    // For example, if this is the first build of a branch, or if
    // the detected type differs from previous builds

    try {
		// Check if this is the first build
        if (env.BUILD_NUMBER == '1') {
			return true
        }

        // You could store the last build type and compare
        // This is a simplified example
        return false

    } catch (Exception e) {
		return false
    }
