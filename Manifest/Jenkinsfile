}

/**
 * Detect build trigger source
 */

def detectBuildTrigger() {
	// Detect who/what triggered the build without importing hudson.* classes
    def triggeredBy = "Unknown"

    // This returns a list of cause maps
    def causes = currentBuild.getBuildCauses()

    if (causes) {
		def cause = causes[0]
        if (cause.shortDescription.contains("GitLab")) {
			triggeredBy = cause.shortDescription
        } else if (cause.userName) {
			triggeredBy = cause.userName
        } else if (cause.shortDescription.toLowerCase().contains("scm change")) {
			triggeredBy = "SCM Trigger"
        } else {
			triggeredBy = cause.shortDescription
        }
    }

    return triggeredBy
}

/**
 * Detect build type from commit message
 * Developers can include hints in their commit messages
 */
def detectBuildTypeFromCommit(String commitMessage) {
	if (!commitMessage) return null

    def message = commitMessage.toLowerCase()

    // Look for explicit build type indicators in commit message
    if (message.contains('[app-only]') || message.contains('#app-only')) {
		return 'app-only'
    }

    if (message.contains('[app-and-db]') || message.contains('#app-and-db') ||
        message.contains('[with-db]') || message.contains('#with-db')) {
		return 'app-and-db'
    }

    // Look for keywords that suggest database changes
    def dbKeywords = ['database', 'migration', 'schema', 'db-', 'postgres', 'mysql', 'mongo']
    if (dbKeywords.any { keyword -> message.contains(keyword) }) {
		return 'app-and-db'
    }

    // Look for keywords that suggest app-only changes
    def appOnlyKeywords = ['frontend', 'ui-', 'styling', 'hotfix', 'bugfix', 'docs']
    if (appOnlyKeywords.any { keyword -> message.contains(keyword) }) {
		return 'app-only'
    }

    return null // No clear indication
}


/**
 * Auto-detect build type based on project structure
 */
def detectBuildTypeFromFiles() {
	def buildType = "app-only" // default

    try {
		// Check if docker-compose.yml exists
        def composeExists = sh(script: 'test -f docker-compose.yml', returnStatus: true) == 0
        def composeYmlExists = sh(script: 'test -f docker-compose.yaml', returnStatus: true) == 0

        if (composeExists || composeYmlExists) {
			echo "Found Docker Compose file, checking for database services..."

            // Check if compose file contains database services
            def composeFile = composeExists ? 'docker-compose.yml' : 'docker-compose.yaml'
            def hasDatabase = sh(
                script: """
                    grep -iE '(postgres|mysql|mongodb|redis|database)' ${composeFile} ||
                    grep -iE 'image:.*\\/(postgres|mysql|mongo|redis)' ${composeFile}
                """,
                returnStatus: true
            ) == 0

            if (hasDatabase) {
				buildType = "app-and-db"
                echo "Detected database services in compose file"
            } else {
				echo "Compose file found but no database services detected"
            }
        } else {
			// Check if Dockerfile exists
            def dockerfileExists = sh(script: 'test -f Dockerfile', returnStatus: true) == 0

            if (dockerfileExists) {
				echo "Found Dockerfile, using single application build"
                buildType = "app-only"
            } else {
				echo "Warning: No Dockerfile or Docker Compose file found!"
                buildType = "app-only" // fallback
            }
        }

    } catch (Exception e) {
		echo "Error detecting build type: ${e.getMessage()}"
        echo "Falling back to app-only build"
        buildType = "app-only"
    }

    return buildType
}

