        //            def gitInfo = commonSteps(
        //            buildType: 'appOnly',
        //            branch: 'main',
        //            repoUrl: 'http://192.168.15.85/jenkins/jenkins-sample-test.git',
        //            credentialsId: 'LASAID'
        //            )
        //            // Print the commit message from the gitInfo map to the console
        //            echo "Git Info: ${gitInfo}"
        //
        //            // Detect who/what triggered the build without importing hudson.* classes
